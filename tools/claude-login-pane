#!/usr/bin/env bash
#
# Sign a Claude account in on this machine, from the Glideslope popup (a host action).
#
#   claude-login-pane <account>             the account's own login home
#   claude-login-pane --default <account>   the shared default home (~/.claude): every
#                                           session there follows (the global switch)
#
# Opens claude.ai in the default browser with the account's email filled in and returns
# at once; a banner says when the login lands, or lands as the wrong account. No terminal,
# no new c11 workspace. The work is tools/claude_signin.py.
set -euo pipefail
PY=/opt/homebrew/bin/python3
[ -x "$PY" ] || PY=python3
exec "$PY" "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/claude_signin.py" "$@"
